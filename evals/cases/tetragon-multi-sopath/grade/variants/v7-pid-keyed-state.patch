 // Each thread has its own state machine to resolve the symbol address
 struct {
-	__uint(type, BPF_MAP_TYPE_TASK_STORAGE); // introduced in 5.11
-	__uint(map_flags, BPF_F_NO_PREALLOC);
-	__type(key, int); // thread-scoped
+	__uint(type, BPF_MAP_TYPE_HASH);
+	__uint(max_entries, 32768);
+	__type(key, __u32); // tgid: resolved symbols are shared by the whole process
 	__type(value, struct pending_call);
 } tg_dyn_sm SEC(".maps");
 
+FUNC_INLINE struct pending_call *dyn_sm_get(int create)
+{
+	static const struct pending_call zero_pc = {};
+	__u32 tgid = get_current_pid_tgid() >> 32;
+	struct pending_call *pc;
+
+	pc = map_lookup_elem(&tg_dyn_sm, &tgid);
+	if (!pc && create) {
+		map_update_elem(&tg_dyn_sm, &tgid, &zero_pc, BPF_NOEXIST);
+		pc = map_lookup_elem(&tg_dyn_sm, &tgid);
+	}
+	return pc;
+}
